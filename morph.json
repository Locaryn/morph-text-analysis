{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-text-analysis",
  "version": "1.0.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Analyse de texte, classification de sentiment, extraction d'entités (NER) et traitements par lots (Batch API). Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-text-analysis",
  "repository": "https://github.com/Locaryn/morph-text-analysis",
  "keywords": [
    "text-analysis",
    "sentiment",
    "ner",
    "classification",
    "batch-processing"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur d'analyse sémantique et textuelle."
    },
    "files.read": {
      "reason": "Lire les corpus de texte et documents à analyser."
    },
    "files.write": {
      "reason": "Exporter les rapports d'analyse et résultats batch."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "text-analysis"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "text-analysis-catalog",
        "slot": "marketplace.catalogs",
        "order": 13,
        "type": "data",
        "label": "Modèles d'analyse de texte",
        "icon": "chart",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles d'analyse et classification au catalogue"
      },
      {
        "id": "text-analysis-studio",
        "slot": "studio.tabs",
        "order": 13,
        "label": "Analyse texte",
        "icon": "chart",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-text-analysis-panel",
        "hint": "Classification de sentiment et extraction d'entités"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
