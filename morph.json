{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-text-analysis",
  "version": "2.1.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Analyse de texte, classification de sentiment, extraction d'entités (NER) et traitements par lots (Batch API). Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-text-analysis",
  "repository": "https://github.com/Locaryn/morph-text-analysis",
  "keywords": [
    "text-analysis",
    "sentiment",
    "ner",
    "classification",
    "batch-processing"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur d'analyse sémantique et textuelle."
    },
    "files.read": {
      "reason": "Lire les corpus de texte et documents à analyser."
    },
    "files.write": {
      "reason": "Exporter les rapports d'analyse et résultats batch."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "text-analysis"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "text-analysis-catalog",
        "slot": "marketplace.catalogs",
        "order": 13,
        "type": "data",
        "label": "Modèles d'analyse de texte",
        "icon": "chart",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles d'analyse et classification au catalogue"
      },
      {
        "id": "text-analysis-studio",
        "slot": "studio.tabs",
        "order": 13,
        "label": "Analyse texte",
        "icon": "chart",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-text-analysis-panel",
        "hint": "Classification de sentiment et extraction d'entités"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-text-analysis#v2.1.0-beta.1"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-text-analysis#v2.0.0"
    },
    {
      "version": "1.5.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.5.0",
      "tag": "v1.5.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-text-analysis#v1.5.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-text-analysis#v1.0.0"
    }
  ]
}
